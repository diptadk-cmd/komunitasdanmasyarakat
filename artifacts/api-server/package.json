{
  "name": "@workspace/api-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed:demo-users": "node --import tsx src/scripts/seed-demo-users.ts",
    "verify:demo-users": "node --import tsx src/scripts/verify-demo-users.ts",
    "clear:demo-transactions": "node --import tsx src/scripts/clear-demo-transactions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "test:communications": "node --import tsx --test src/lib/communications.test.ts src/lib/communications.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "multer": "^2.1.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.5",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
