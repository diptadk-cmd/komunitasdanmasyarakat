# Database MariaDB/MySQL
MARIADB_URL=mysql://root@127.0.0.1:3306/jaksanggar
# DATABASE_URL dapat dipakai sebagai nama alternatif.

# API
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5180,http://localhost:5181

# Reset kata sandi via email SMTP (server-only; jangan gunakan prefix VITE_)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=JAK SANGGAR
# Hanya untuk pengembangan lokal; jangan aktifkan di production.
PASSWORD_RESET_DEV_EXPOSE_OTP=false

# Penyimpanan S3/MinIO (opsional; tanpa ini penyimpanan lokal digunakan)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=jak-sanggar
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Alternatif produksi murah untuk server tunggal bila S3/MinIO tidak dipakai.
# Gunakan path absolut yang persisten dan ikut dibackup.
LOCAL_STORAGE_DIR=

# Set 1 only when the API is private behind one Caddy reverse proxy.
TRUST_PROXY_HOPS=0
